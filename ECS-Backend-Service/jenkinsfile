pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        ACCOUNT_ID = "855983325095"

        BACKEND_REPO = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/nikbsoft-ecrrepo-backend-dev"
        IMAGE_TAG = ${BUILD_NUMBER}

        STACK_NAME = "nikbsoft-ecs-service-backend-dev"
    }

    stages {

        // ----------------------------------
        // 1. Checkout Application Code
        // ----------------------------------
         stage('Checkout appcode') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Bsindhujareddy/nikbsoft-backend-app-container.git',
                    credentialsId: 'github-cred'
            }
        }
        
         stage('Debug Files1') {
       steps {
               sh '''
                 pwd
                 ls -la
                 ls -l backend
                  '''
              }
           }

        stage('build docker image and push') {
            steps {
                withAWS(credentials: 'aws-cred', region: "${AWS_REGION}") {
                    sh '''
                    aws ecr get-login-password --region $AWS_REGION | \
                    docker login --username AWS --password-stdin $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
					cd backend
                    docker build -t backend-app .
                    docker tag backend-app $BACKEND_REPO:$IMAGE_TAG
					docker push $BACKEND_REPO:$IMAGE_TAG
                    '''
                }
            }
        }
        // ----------------------------------
        // 2. Checkout Infra Repo
        // ----------------------------------
        stage('Checkout Infra Repo') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Bsindhujareddy/nikbsoft-awscf-infra.git',
                    credentialsId: 'github-cred'
            }
        }

         stage('Debug Files2') {
       steps {
               sh '''
                 pwd
                 ls -la
                  '''
              }
           }
        stage('Prepare CF Parameters') {
        steps {
               sh """
                     cd ECS-Backend-Service
                     sed -i 's|image-tag|${BUILD_NUMBER}|g' dev.parameters.json
                     cat dev.parameters.json
                """
              }
            }
        stage('Deploy ECS Service') {
            steps {
                withAWS(credentials: 'aws-cred', region: "${REGION}") {
                    sh '''
                    cd ECS-Backend-Service
                    aws cloudformation deploy \
                      --stack-name $STACK_NAME \
                      --template-file main.json \
                      --parameter-overrides $(cat dev.parameters.json | jq -r 'to_entries|map("\\(.key)=\\(.value|tostring)")|.[]') \
                      --capabilities CAPABILITY_NAMED_IAM
                    '''
                }
            }
        }
        
    }
}