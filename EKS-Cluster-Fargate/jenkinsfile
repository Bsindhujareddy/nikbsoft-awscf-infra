pipeline {
    agent any

    environment {
        STACK_NAME = "nikbsoft-eks-cluster-dev"
        REGION = "us-east-1"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Bsindhujareddy/nikbsoft-awscf-infra.git',
                    credentialsId: 'github-cred'
            }
        }
        stage('Debug Files') {
       steps {
               sh '''
                 pwd
                 ls -la
                  '''
              }
           }
        stage('Validate Template') {
            steps {
                withAWS(credentials: 'aws-cred', region: "${REGION}") {
                    sh '''
                    aws cloudformation validate-template \
                      --template-body file://EKS-Cluster-Fargate/main.json
                    '''
                }
            }
        }

        stage('Deploy Stack') {
            steps {
                withAWS(credentials: 'aws-cred', region: "${REGION}") {
                    sh '''
                    cd EKS-Cluster-Fargate
                    aws cloudformation deploy \
                      --stack-name $STACK_NAME \
                      --template-file main.json \
                      --parameter-overrides $(cat dev.parameters.json | jq -r 'to_entries|map("\\(.key)=\\(.value|tostring)")|.[]') \
                      --capabilities CAPABILITY_NAMED_IAM
                    '''
                }
            }
        }
    }
}